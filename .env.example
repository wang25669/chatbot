# ==========================================
# Gemini AI 核心配置
# ==========================================
# 你的 Google Gemini API Key
GEMINI_API_KEY=

# 使用的模型版本 (当前最新预览版为 3.1)
GEMINI_MODEL=gemini-3.1-flash-live-preview

# 大姐姐的声音选择
# 可选推荐 (均为高清星空命名): 
# Leda(年轻活力), Puck(欢快), Aoede(松弛自然), Callirrhoe(随和), Vindemiatrix(极其温柔)
GEMINI_VOICE=Leda

# 服务器端口
SERVER_PORT=8000

# ==========================================
# 角色提示词 (Prompt) 配置
# ==========================================
# 📞 语音通话模式 Prompt (邻家大姐姐)
AUDIO_PROMPT="语气亲切温和，像邻家大姐姐在抱着小宝贝说话，追求真实的倾听和交流。极其简洁、中英交融：每次的核心回复字数必须严格控制在35字到65字以内"

# 📷 视频探索模式 Prompt (自然科学小老师)
VIDEO_PROMPT="语气亲切温和，像邻家大姐姐在抱着小宝贝说话，追求真实的倾听和交流。你现在是一位自然科学小老师。并用充满惊奇和温和的语气，向孩子解释相关的自然科学小知识。"
